+bool WireGuard::waitForHandshake(uint32_t timeoutMs) {
+	if (!this->_is_initialized || wg_netif == nullptr || s_wireguard_peer_index == WIREGUARDIF_INVALID_INDEX) {
+		return false;
+	}
+	const TickType_t started = xTaskGetTickCount();
+	const TickType_t timeout = pdMS_TO_TICKS(timeoutMs);
+	while (xTaskGetTickCount() - started < timeout) {
+		LOCK_TCPIP_CORE();
+		const bool ready = wireguardif_peer_is_up(wg_netif, s_wireguard_peer_index, nullptr, nullptr) == ERR_OK;
+		UNLOCK_TCPIP_CORE();
+		if (ready) return true;
+		vTaskDelay(pdMS_TO_TICKS(100));
+	}
+	return false;
+}
